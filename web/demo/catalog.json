          "denominator": "第 7 自然日已完整结束且数据水位覆盖的注册 cohort 用户数",
          "grain": "用户",
          "window": "[注册日 + 1 日, 注册日 + 7 日]",
          "maturity": {
            "type": "calendar",
            "days": 7
          },
          "calculation": {
            "success_column": "within7"
