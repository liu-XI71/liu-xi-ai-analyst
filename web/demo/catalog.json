          "columns": [
            "scenario",
            "as_of"
          ]
        }
      ],
      "examples": [
        {
          "question": "最近两个成熟注册周的精确 D7 为什么变化？结合渠道、端、版本与注册后漏斗，给出下一步验证。",
          "task": "diagnose"
        },
        {
          "question": "检查注册后 24 小时有序漏斗，定位本期最大的转化损失。",
          "task": "funnel"
        },
        {
          "question": "检查延迟快照的留存数据质量，列出批次缺口与恢复条件。",
          "task": "quality",
          "filters": {
            "scenario": "late_data"
