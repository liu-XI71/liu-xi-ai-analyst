      "funnel_contract": {
        "id": "registration_to_activation_24h",
        "window_hours": 24,
        "interval": "[注册时间, 注册时间 + 24 小时)",
        "steps": [
          {
            "id": "registered",
            "name": "注册成功",
            "event": "signup"
          },
          {
            "id": "onboarded",
            "name": "完成引导",
            "event": "onboarding_completed"
          },
