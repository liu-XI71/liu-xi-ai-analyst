          "denominator": "不适用",
          "grain": "用户",
          "window": "注册日期区间",
          "maturity": {
            "type": "calendar",
            "days": 0
          },
          "calculation": {
            "success_column": "registered"
          },
          "version": "onboarding.v2.0.0",
          "timezone": "Asia/Shanghai",
