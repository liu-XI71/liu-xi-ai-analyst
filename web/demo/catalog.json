          "id": "negative_feedback_24h",
          "name": "注册后 24 小时负反馈率",
          "unit": "%",
          "definition": "有至少一次 negative_feedback 事件的分配用户 / 所有分配用户；[注册时间, 注册时间+24h)；仅完整窗口"
        }
