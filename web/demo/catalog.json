          "dimensions": [
            "channel",
            "device",
            "app_version"
          ]
        },
        {
          "id": "daily_active_users",
          "name": "日活跃用户数",
          "unit": "人",
          "kind": "count",
          "numerator": "当日 app_active 或 content_consumed 的去重匿名用户数",
          "denominator": "不适用",
          "grain": "用户 × 自然日",
          "window": "指定自然日",
          "maturity": {
            "type": "calendar",
            "days": 0
          },
          "calculation": {
            "events": [
              "app_active",
              "content_consumed"
            ]
          },
          "notes": "注册事件自身不算活跃；跨日求和得到用户日，不能当作期间去重用户",
          "version": "onboarding.v2.0.0",
          "timezone": "Asia/Shanghai",
          "data_source": "固定种子 710919 的匿名合成产品事件；用于复现增长分析方法，不代表真实企业经营收益",
          "dimensions": [
            "channel",
            "device",
            "app_version"
          ]
        },
        {
          "id": "first_feed_failure_rate",
          "name": "24 小时首次 Feed 请求失败率",
          "unit": "%",
          "kind": "rate",
          "numerator": "注册后 24 小时内首次 Feed 请求明确失败的去重用户数",
          "denominator": "注册后 24 小时内有首次 Feed 请求、且已满 24 小时的 cohort 用户数",
          "grain": "用户的首次 Feed 请求",
          "window": "[注册时间, 注册时间 + 24 小时)",
          "maturity": {
            "type": "hours",
            "hours": 24
          },
          "calculation": {
            "success_column": "feed_failed",
            "denominator_column": "feed_requested"
          },
          "notes": "缺少请求结果不自动记为失败，也不记为成功；完整性由独立质量检查控制",
          "version": "onboarding.v2.0.0",
          "timezone": "Asia/Shanghai",
          "data_source": "固定种子 710919 的匿名合成产品事件；用于复现增长分析方法，不代表真实企业经营收益",
          "dimensions": [
            "channel",
            "device",
            "app_version"
          ]
        },
        {
          "id": "negative_feedback_24h",
          "name": "24 小时负反馈用户率",
          "unit": "%",
          "kind": "rate",
          "numerator": "注册后 24 小时内至少一次 negative_feedback 的 cohort 去重用户数",
          "denominator": "满 24 小时且质量通过的注册 cohort 用户数",
          "grain": "用户",
          "window": "[注册时间, 注册时间 + 24 小时)",
          "maturity": {
            "type": "hours",
            "hours": 24
          },
          "calculation": {
            "success_column": "negative_feedback"
          },
          "notes": "演示事件代表不感兴趣或举报；用作描述性体验围栏",
          "version": "onboarding.v2.0.0",
          "timezone": "Asia/Shanghai",
          "data_source": "固定种子 710919 的匿名合成产品事件；用于复现增长分析方法，不代表真实企业经营收益",
