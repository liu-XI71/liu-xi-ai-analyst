  "evidence": [
    {
      "id": "growth-totals",
      "label": "两期成熟用户与留存人数",
      "sql": "WITH periods AS (SELECT 'current' AS period, :start AS start_date, :end AS end_date UNION ALL SELECT 'previous', :compare_start, :compare_end), cohort AS (\n        SELECT p.period, u.user_id, u.signup_date, u.channel, u.device,\n            u.experiment_arm, u.incentive_cost, u.revenue_7d,\n            EXISTS(SELECT 1 FROM growth_activity a\n                WHERE a.user_id = u.user_id\n                  AND a.activity_date > u.signup_date\n                  AND a.activity_date <= date(u.signup_date, '+7 days')) AS retained\n        FROM growth_users u JOIN periods p\n          ON u.signup_date BETWEEN p.start_date AND p.end_date\n        WHERE date(u.signup_date, '+7 days') <= :snapshot\n    ) SELECT period, COUNT(*) AS users, SUM(retained) AS retained_users FROM cohort GROUP BY period",
      "parameters": {
        "start": "2026-08-24",
        "end": "2026-08-30",
        "snapshot": "2026-09-06",
        "compare_start": "2026-08-17",
        "compare_end": "2026-08-23"
      },
      "rows": [
        {
          "period": "current",
          "users": 1095,
          "retained_users": 294
        },
        {
          "period": "previous",
          "users": 1163,
          "retained_users": 419
        }
      ],
      "source": "固定种子 71 的合成增长数据；非真实企业经营结果",
      "metric_version": "growth.v1.0"
    },
